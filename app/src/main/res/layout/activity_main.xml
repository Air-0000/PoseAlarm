<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <!-- 顶部标题栏：黑底黄字，副标题显示下一个闹钟 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/bar_bg"
        android:theme="@style/ThemeOverlay.PoseAlarm.Toolbar"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.PoseAlarm.ToolbarTitle"
        app:titleTextColor="@color/hazard"
        app:subtitleTextAppearance="@style/TextAppearance.PoseAlarm.ToolbarSubtitle"
        app:subtitleTextColor="@color/bar_subtitle" />

    <com.posealarm.HazardStripeView
        android:layout_width="match_parent"
        android:layout_height="@dimen/hazard_stripe_height" />

    <!-- 缺少权限时的提醒：黄底警示卡片 -->
    <LinearLayout
        android:id="@+id/layout_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_tag_hazard"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_permission"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/on_hazard"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_permission"
            style="@style/Widget.PoseAlarm.Button.Hard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="44dp"
            android:text="去开启" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />

        <!-- 空状态：使用步骤 -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card_hard"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="19dp"
            android:paddingBottom="19dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还没有闹钟"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout style="@style/Widget.PoseAlarm.EmptyStep">
                <TextView style="@style/Widget.PoseAlarm.EmptyStep.Number" android:text="1" />
                <TextView style="@style/Widget.PoseAlarm.EmptyStep.Text" android:text="点「新闹钟」，选时间和关闹钟的动作：深蹲、开合跳、双手举高或 T 字站姿" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.PoseAlarm.EmptyStep">
                <TextView style="@style/Widget.PoseAlarm.EmptyStep.Number" android:text="2" />
                <TextView style="@style/Widget.PoseAlarm.EmptyStep.Text" android:text="睡前把手机立在能拍到全身的位置，前置摄像头对着你" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.PoseAlarm.EmptyStep">
                <TextView style="@style/Widget.PoseAlarm.EmptyStep.Number" android:text="3" />
                <TextView style="@style/Widget.PoseAlarm.EmptyStep.Text" android:text="闹钟响了，对着镜头做完动作，铃声才会停。没有贪睡按钮" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test"
            style="@style/Widget.PoseAlarm.Button.Hard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="试响一次" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add"
            style="@style/Widget.PoseAlarm.Button.Hard.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="＋ 新闹钟" />
    </LinearLayout>
</LinearLayout>
